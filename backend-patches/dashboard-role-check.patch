+# Who may see the shop's dashboard figures. Copied from the frontend: the roles that may open Reports see
+# the money figures (sales, profit, what customers owe, purchases, expenses); the roles that move stock see
+# the stock figures only. A cashier sees neither: the frontend sends a cashier straight to the till.
+DASHBOARD_MONEY_ROLES = frozenset(
+	{
+		"System Manager",
+		"Sales Manager",
+		"Purchase Manager",
+		"Stock Manager",
+		"Item Manager",
+		"Accounts Manager",
+		"Accounts User",
+		"Delivery Manager",
+		"Agent Manager",
+		"Analytics",
+		"Auditor",
+		"Expense Approver",
+		"Dashboard Manager",
+		"Agriculture Manager",
+	}
+)
+DASHBOARD_STOCK_ROLES = STOCK_ROLES | TRANSFER_ROLES
+
 
 def require_manager() -> None:
 	"""Refuse anyone who is not signed in, or is not a business owner (System Manager) or the Administrator."""
@@ -162,6 +185,19 @@ def require_credit_role() -> None:
 	require_any_role(CREDIT_ROLES, _("change customer credit limits"))
 
 
+def require_dashboard_role() -> None:
+	"""Reading the dashboard figures: money roles and stock roles only, never a cashier."""
+	require_any_role(DASHBOARD_MONEY_ROLES | DASHBOARD_STOCK_ROLES, _("see the dashboard figures"))
+
+
+def may_see_money_figures() -> bool:
+	"""True for the Administrator and the roles that may open Reports in the frontend."""
+	user = frappe.session.user
+	if user == "Administrator":
+		return True
+	return bool(DASHBOARD_MONEY_ROLES & set(frappe.get_roles(user)))
+
+
 def require_loyalty_role() -> None:
 	"""Creating a loyalty program or assigning one to customers."""
 	require_any_role(LOYALTY_ROLES, _("manage loyalty programs"))
